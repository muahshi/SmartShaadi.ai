<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SmartShaadi — Vendor Lead Agent</title>
<link rel="canonical" href="https://smartshaadi.online/agents/agent-vendor-lead.html">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{--gold:#C9A84C;--gold-light:#E8C96A;--gold-bg:rgba(201,168,76,0.07);--gold-bd:rgba(201,168,76,0.25);--bg:#08060E;--bg2:#0F0C18;--bg3:#16121F;--text:#F5EFE0;--muted:#A89070;--green:#4ADE80;--red:#F87171;}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;min-height:100vh;}
body::before{content:'';position:fixed;top:-30%;right:-20%;width:60%;height:60%;background:radial-gradient(ellipse,rgba(201,168,76,0.05) 0%,transparent 70%);pointer-events:none;z-index:0;}
.container{max-width:920px;margin:0 auto;padding:0 1.5rem;position:relative;z-index:1;}
header{padding:2rem 0 1.5rem;border-bottom:1px solid var(--gold-bd);margin-bottom:2rem;}
.header-inner{display:flex;align-items:center;gap:1rem;}
.logo-mark{width:42px;height:42px;background:linear-gradient(135deg,var(--gold),var(--gold-light));border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;}
.logo-text h1{font-family:'Cormorant Garamond',serif;font-size:1.4rem;font-weight:700;color:var(--gold);line-height:1;}
.logo-text p{font-size:0.72rem;color:var(--muted);letter-spacing:0.08em;text-transform:uppercase;margin-top:2px;}
.badge{margin-left:auto;background:var(--gold-bg);border:1px solid var(--gold-bd);color:var(--gold);font-size:0.68rem;padding:0.25rem 0.7rem;border-radius:20px;letter-spacing:0.06em;text-transform:uppercase;}
.back-btn{color:var(--muted);font-size:0.82rem;text-decoration:none;display:flex;align-items:center;gap:0.3rem;margin-right:0.5rem;}
.back-btn:hover{color:var(--gold);}
.hero{text-align:center;padding:1rem 0 2rem;}
.hero h2{font-family:'Cormorant Garamond',serif;font-size:clamp(1.8rem,5vw,2.6rem);font-weight:700;line-height:1.2;margin-bottom:0.75rem;}
.hero h2 span{color:var(--gold);}
.hero p{color:var(--muted);font-size:0.95rem;max-width:520px;margin:0 auto;line-height:1.6;}

/* Tabs */
.tabs{display:flex;gap:0.5rem;margin-bottom:1.5rem;border-bottom:1px solid var(--gold-bd);padding-bottom:0;}
.tab-btn{background:transparent;border:none;color:var(--muted);padding:0.6rem 1.1rem;font-family:'DM Sans',sans-serif;font-size:0.85rem;cursor:pointer;position:relative;transition:color 0.2s;}
.tab-btn.active{color:var(--gold);}
.tab-btn.active::after{content:'';position:absolute;bottom:-1px;left:0;right:0;height:2px;background:var(--gold);}
.tab-content{display:none;}
.tab-content.active{display:block;}

.card{background:var(--bg2);border:1px solid var(--gold-bd);border-radius:16px;padding:1.75rem;margin-bottom:1.5rem;}
.section-label{font-size:0.72rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--gold);margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;}
.section-label::after{content:'';flex:1;height:1px;background:var(--gold-bd);}
.input-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;}
@media(max-width:600px){.input-grid{grid-template-columns:1fr;}}
.field label{display:block;font-size:0.8rem;color:var(--muted);margin-bottom:0.4rem;}
.field input,.field select,.field textarea{width:100%;background:var(--bg3);border:1px solid rgba(201,168,76,0.2);color:var(--text);padding:0.65rem 0.9rem;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:0.88rem;outline:none;transition:border-color 0.2s;}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--gold);}
.field textarea{resize:vertical;min-height:70px;}
.field select option{background:var(--bg3);}
.full-width{grid-column:1/-1;}
.generate-btn{width:100%;background:linear-gradient(135deg,var(--gold),var(--gold-light));color:#08060E;border:none;padding:0.9rem;border-radius:10px;font-family:'DM Sans',sans-serif;font-size:0.95rem;font-weight:600;cursor:pointer;margin-top:1.25rem;transition:opacity 0.2s;display:flex;align-items:center;justify-content:center;gap:0.5rem;}
.generate-btn:hover{opacity:0.92;}
.generate-btn:disabled{opacity:0.5;cursor:not-allowed;}

.loading{display:none;text-align:center;padding:2rem;}
.loading.show{display:block;}
.spinner{width:32px;height:32px;border:2px solid var(--gold-bd);border-top-color:var(--gold);border-radius:50%;animation:spin 0.8s linear infinite;margin:0 auto 0.75rem;}
@keyframes spin{to{transform:rotate(360deg);}}
.loading p{color:var(--muted);font-size:0.88rem;}

.results{display:none;}
.results.show{display:block;}
.output-box{background:var(--bg2);border:1px solid var(--gold-bd);border-radius:12px;margin-bottom:1rem;overflow:hidden;}
.output-head{padding:0.85rem 1.25rem;border-bottom:1px solid rgba(201,168,76,0.12);display:flex;align-items:center;justify-content:space-between;}
.output-head span{font-weight:600;font-size:0.88rem;}
.copy-btn{background:var(--gold-bg);border:1px solid var(--gold-bd);color:var(--gold);padding:0.3rem 0.75rem;border-radius:6px;font-size:0.75rem;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all 0.2s;}
.copy-btn.copied{color:var(--green);border-color:var(--green);background:rgba(74,222,128,0.08);}
.output-body{padding:1.25rem;font-size:0.875rem;line-height:1.7;white-space:pre-wrap;word-break:break-word;}

.pricing-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:1.5rem;}
@media(max-width:600px){.pricing-cards{grid-template-columns:1fr;}}
.pricing-card{background:var(--bg2);border:1px solid var(--gold-bd);border-radius:12px;padding:1.25rem;text-align:center;}
.pricing-card.featured{border-color:var(--gold);background:linear-gradient(135deg,rgba(201,168,76,0.08),rgba(201,168,76,0.03));}
.price-tier{font-size:0.72rem;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted);margin-bottom:0.5rem;}
.price-amount{font-family:'Cormorant Garamond',serif;font-size:2rem;color:var(--gold);font-weight:700;line-height:1;}
.price-period{font-size:0.72rem;color:var(--muted);margin-bottom:0.75rem;}
.price-features{font-size:0.78rem;color:var(--muted);line-height:1.8;text-align:left;}
.price-features li{list-style:none;padding-left:1rem;position:relative;}
.price-features li::before{content:'✓';position:absolute;left:0;color:var(--green);}

.error-msg{display:none;background:rgba(248,113,113,0.08);border:1px solid rgba(248,113,113,0.3);color:var(--red);padding:1rem 1.25rem;border-radius:10px;font-size:0.875rem;margin-bottom:1.5rem;}
.error-msg.show{display:block;}

footer{text-align:center;padding:2rem 0;color:var(--muted);font-size:0.78rem;border-top:1px solid rgba(201,168,76,0.1);margin-top:3rem;}
footer a{color:var(--gold);text-decoration:none;}
</style>
</head>
<body>
<div class="container">
  <header>
    <div class="header-inner">
      <a href="/agents/" class="back-btn">← Back</a>
      <div class="logo-mark">🤝</div>
      <div class="logo-text">
        <h1>SmartShaadi AI</h1>
        <p>Vendor Lead Agent</p>
      </div>
      <div class="badge">Phase 4</div>
    </div>
  </header>

  <div class="hero">
    <h2>Vendors Ko <span>Convert Karo</span><br>AI-Powered Scripts Se</h2>
    <p>Vendor onboarding emails, welcome messages, pricing pitch scripts aur monthly reports — sab kuch AI se.</p>
  </div>

  <div class="tabs">
    <button class="tab-btn active" onclick="switchTab('welcome')">📧 Welcome Email</button>
    <button class="tab-btn" onclick="switchTab('pitch')">💰 Pricing Pitch</button>
    <button class="tab-btn" onclick="switchTab('followup')">🔁 Follow-up</button>
    <button class="tab-btn" onclick="switchTab('pricing')">🏷️ Plans</button>
  </div>

  <!-- Welcome Email Tab -->
  <div class="tab-content active" id="tab-welcome">
    <div class="card">
      <div class="section-label">📝 Vendor Details</div>
      <div class="input-grid">
        <div class="field"><label>Vendor Name *</label><input type="text" id="w-name" placeholder="e.g. Sharma Photography" /></div>
        <div class="field"><label>Vendor Type</label>
          <select id="w-type">
            <option>Photography/Videography</option><option>Catering</option><option>Decoration/Floral</option>
            <option>Venue/Banquet Hall</option><option>Bridal Makeup</option><option>DJ/Music</option>
            <option>Wedding Planner</option><option>Invitation/Printing</option><option>Mehendi Artist</option>
          </select>
        </div>
        <div class="field"><label>City</label><input type="text" id="w-city" placeholder="e.g. Delhi" /></div>
        <div class="field"><label>Chosen Plan</label>
          <select id="w-plan"><option value="basic">Basic — ₹999/month</option><option value="featured">Featured — ₹1,999/month</option><option value="premium">Premium — ₹2,999/month</option></select>
        </div>
        <div class="field full-width"><label>Any special notes</label><textarea id="w-notes" placeholder="e.g. 5 saal ka experience hai, 200+ weddings covered..."></textarea></div>
      </div>
      <button class="generate-btn" id="w-btn" onclick="generateWelcome()">✨ Welcome Email Generate Karo</button>
    </div>
    <div class="loading" id="w-loading"><div class="spinner"></div><p>Email draft ho rahi hai...</p></div>
    <div class="error-msg" id="w-error"></div>
    <div class="results" id="w-results"></div>
  </div>

  <!-- Pricing Pitch Tab -->
  <div class="tab-content" id="tab-pitch">
    <div class="card">
      <div class="section-label">🎯 Pitch Details</div>
      <div class="input-grid">
        <div class="field"><label>Vendor Business Name *</label><input type="text" id="p-name" placeholder="e.g. Royal Caterers" /></div>
        <div class="field"><label>Vendor Type</label>
          <select id="p-type"><option>Photography/Videography</option><option>Catering</option><option>Decoration/Floral</option><option>Venue/Banquet Hall</option><option>Bridal Makeup</option><option>DJ/Music</option><option>Wedding Planner</option></select>
        </div>
        <div class="field"><label>City</label><input type="text" id="p-city" placeholder="e.g. Mumbai" /></div>
        <div class="field"><label>Contact Channel</label>
          <select id="p-channel"><option>WhatsApp</option><option>Email</option><option>Phone Call Script</option></select>
        </div>
      </div>
      <button class="generate-btn" id="p-btn" onclick="generatePitch()">✨ Pitch Script Generate Karo</button>
    </div>
    <div class="loading" id="p-loading"><div class="spinner"></div><p>Pitch script ban rahi hai...</p></div>
    <div class="error-msg" id="p-error"></div>
    <div class="results" id="p-results"></div>
  </div>

  <!-- Follow-up Tab -->
  <div class="tab-content" id="tab-followup">
    <div class="card">
      <div class="section-label">🔁 Follow-up Details</div>
      <div class="input-grid">
        <div class="field"><label>Vendor Name *</label><input type="text" id="f-name" placeholder="e.g. Meera Decor" /></div>
        <div class="field"><label>Days Since Last Contact</label>
          <select id="f-days"><option value="3">3 din</option><option value="7">1 hafte</option><option value="14">2 hafte</option><option value="30">1 mahine</option></select>
        </div>
        <div class="field"><label>Follow-up Type</label>
          <select id="f-type"><option>Plan Renewal Reminder</option><option>Listing Update Request</option><option>Payment Follow-up</option><option>Re-engagement (Inactive)</option></select>
        </div>
        <div class="field"><label>Tone</label>
          <select id="f-tone"><option>Friendly Reminder</option><option>Gentle Urgency</option><option>Value Highlight</option></select>
        </div>
      </div>
      <button class="generate-btn" id="f-btn" onclick="generateFollowup()">✨ Follow-up Message Generate Karo</button>
    </div>
    <div class="loading" id="f-loading"><div class="spinner"></div><p>Message ban raha hai...</p></div>
    <div class="error-msg" id="f-error"></div>
    <div class="results" id="f-results"></div>
  </div>

  <!-- Pricing Tab -->
  <div class="tab-content" id="tab-pricing">
    <div class="pricing-cards">
      <div class="pricing-card">
        <div class="price-tier">Basic</div>
        <div class="price-amount">₹999</div>
        <div class="price-period">per month</div>
        <ul class="price-features">
          <li>Standard listing</li>
          <li>1 category</li>
          <li>Contact form</li>
          <li>Basic analytics</li>
        </ul>
      </div>
      <div class="pricing-card featured">
        <div class="price-tier">⭐ Featured</div>
        <div class="price-amount">₹1,999</div>
        <div class="price-period">per month</div>
        <ul class="price-features">
          <li>Highlighted listing</li>
          <li>3 categories</li>
          <li>Priority placement</li>
          <li>Leads analytics</li>
          <li>WhatsApp leads</li>
        </ul>
      </div>
      <div class="pricing-card">
        <div class="price-tier">Premium</div>
        <div class="price-amount">₹2,999</div>
        <div class="price-period">per month</div>
        <ul class="price-features">
          <li>Top placement + badge</li>
          <li>All categories</li>
          <li>Featured on homepage</li>
          <li>Full analytics</li>
          <li>Direct leads</li>
          <li>Social media mention</li>
        </ul>
      </div>
    </div>
    <div class="card">
      <div class="section-label">📊 ROI Calculator</div>
      <div class="input-grid">
        <div class="field"><label>Average Order Value (₹)</label><input type="number" id="r-aov" placeholder="e.g. 50000" value="50000" /></div>
        <div class="field"><label>Expected Monthly Leads</label><input type="number" id="r-leads" placeholder="e.g. 10" value="10" /></div>
        <div class="field"><label>Conversion Rate (%)</label><input type="number" id="r-conv" placeholder="e.g. 20" value="20" /></div>
        <div class="field"><label>Selected Plan</label>
          <select id="r-plan"><option value="999">Basic — ₹999</option><option value="1999" selected>Featured — ₹1,999</option><option value="2999">Premium — ₹2,999</option></select>
        </div>
      </div>
      <button class="generate-btn" onclick="calcROI()">📊 ROI Calculate Karo</button>
      <div id="roi-result" style="margin-top:1rem;display:none;"></div>
    </div>
  </div>

  <footer>Powered by <a href="https://smartshaadi.online">SmartShaadi AI</a> &nbsp;·&nbsp; India ka #1 Free AI Wedding Planning Platform</footer>
</div>

<script>
function switchTab(name) {
  document.querySelectorAll('.tab-btn').forEach((b,i) => b.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  document.querySelector(`#tab-${name}`).classList.add('active');
  event.target.classList.add('active');
}

async function callAPI(prompt, loadingId, btnId, errorId) {
  document.getElementById(loadingId).classList.add('show');
  document.getElementById(btnId).disabled = true;
  document.getElementById(errorId).classList.remove('show');
  
  try {
    const res = await fetch('/api/chat', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ model:'claude-sonnet-4-20250514', max_tokens:1500, messages:[{role:'user',content:prompt}] })
    });
    const data = await res.json();
    const raw = data.content?.[0]?.text || '';
    const clean = raw.replace(/```json|```/g,'').trim();
    document.getElementById(loadingId).classList.remove('show');
    document.getElementById(btnId).disabled = false;
    return JSON.parse(clean);
  } catch(e) {
    document.getElementById(loadingId).classList.remove('show');
    document.getElementById(btnId).disabled = false;
    const err = document.getElementById(errorId);
    err.textContent = 'Error: ' + e.message;
    err.classList.add('show');
    return null;
  }
}

function showResults(containerId, items) {
  const res = document.getElementById(containerId);
  res.innerHTML = '';
  items.forEach(item => {
    const id = 'r_' + Math.random().toString(36).substr(2,5);
    const box = document.createElement('div');
    box.className = 'output-box';
    box.innerHTML = `<div class="output-head"><span>${item.title}</span><button class="copy-btn" id="${id}" onclick="copyText('${id}',\`${esc(item.content)}\`)">📋 Copy</button></div><div class="output-body">${escHtml(item.content)}</div>`;
    res.appendChild(box);
  });
  res.classList.add('show');
  res.scrollIntoView({behavior:'smooth',block:'start'});
}

async function generateWelcome() {
  const name = document.getElementById('w-name').value.trim();
  if (!name) { showErr('w-error','Vendor name zaroori hai!'); return; }
  const type = document.getElementById('w-type').value;
  const city = document.getElementById('w-city').value;
  const plan = document.getElementById('w-plan').value;
  const notes = document.getElementById('w-notes').value;

  const prompt = `You are SmartShaadi AI vendor relations team. Generate a warm welcome email for a new vendor who just joined SmartShaadi.online vendor directory.

Vendor: ${name} | Type: ${type} | City: ${city} | Plan: ${plan} | Notes: ${notes}

SmartShaadi Vendor Plans: Basic ₹999/mo, Featured ₹1,999/mo, Premium ₹2,999/mo
Vendor Directory: https://smartshaadi.online/vendors/
Admin Panel: https://smartshaadi.online/admin.html

Return JSON only: {"subject": "email subject", "email": "full email body in Hinglish, warm and professional", "whatsapp": "shorter WhatsApp version of same message"}`;

  const data = await callAPI(prompt, 'w-loading', 'w-btn', 'w-error');
  if (data) showResults('w-results', [{title:'📧 Email (Subject: '+data.subject+')',content:data.email},{title:'💬 WhatsApp Version',content:data.whatsapp}]);
}

async function generatePitch() {
  const name = document.getElementById('p-name').value.trim();
  if (!name) { showErr('p-error','Vendor name zaroori hai!'); return; }
  const type = document.getElementById('p-type').value;
  const city = document.getElementById('p-city').value;
  const channel = document.getElementById('p-channel').value;

  const prompt = `You are SmartShaadi AI sales team. Create a compelling pitch script to convince ${name} (${type} in ${city}) to join SmartShaadi vendor directory.

Channel: ${channel}
Plans: Basic ₹999/mo | Featured ₹1,999/mo | Premium ₹2,999/mo
Key benefits: 40,000+ monthly visitors, India's #1 free AI wedding platform, targeted wedding leads
URL: https://smartshaadi.online/vendors/apply.html

Return JSON only: {"pitch": "complete pitch script for ${channel}, in Hinglish, with objection handling included", "keyPoints": ["point1","point2","point3"]}`;

  const data = await callAPI(prompt, 'p-loading', 'p-btn', 'p-error');
  if (data) showResults('p-results', [
    {title:`💬 ${channel} Pitch Script`,content:data.pitch},
    {title:'🎯 Key Points to Highlight',content:(data.keyPoints||[]).map((p,i)=>`${i+1}. ${p}`).join('\n')}
  ]);
}

async function generateFollowup() {
  const name = document.getElementById('f-name').value.trim();
  if (!name) { showErr('f-error','Vendor name zaroori hai!'); return; }
  const days = document.getElementById('f-days').value;
  const type = document.getElementById('f-type').value;
  const tone = document.getElementById('f-tone').value;

  const prompt = `You are SmartShaadi AI vendor relations. Write a follow-up message for vendor ${name}.
Type: ${type} | Days since contact: ${days} | Tone: ${tone}
SmartShaadi: India's #1 free AI wedding planning platform — 40,000+ monthly visitors.

Return JSON only: {"whatsapp": "WhatsApp follow-up message in Hinglish", "email": "email follow-up version"}`;

  const data = await callAPI(prompt, 'f-loading', 'f-btn', 'f-error');
  if (data) showResults('f-results', [{title:'💬 WhatsApp Follow-up',content:data.whatsapp},{title:'📧 Email Follow-up',content:data.email}]);
}

function calcROI() {
  const aov = parseFloat(document.getElementById('r-aov').value)||50000;
  const leads = parseFloat(document.getElementById('r-leads').value)||10;
  const conv = parseFloat(document.getElementById('r-conv').value)||20;
  const plan = parseFloat(document.getElementById('r-plan').value)||1999;
  const bookings = leads * (conv/100);
  const revenue = bookings * aov;
  const roi = ((revenue - plan) / plan * 100).toFixed(0);
  const div = document.getElementById('roi-result');
  div.style.display = 'block';
  div.innerHTML = `<div style="display:grid;grid-template-columns:repeat(2,1fr);gap:0.75rem;">
    <div style="background:var(--bg3);border:1px solid var(--gold-bd);border-radius:10px;padding:1rem;text-align:center;">
      <div style="font-family:'Cormorant Garamond',serif;font-size:1.8rem;color:var(--gold);font-weight:700;">₹${revenue.toLocaleString('en-IN')}</div>
      <div style="font-size:0.72rem;color:var(--muted);margin-top:2px;text-transform:uppercase;">Estimated Monthly Revenue</div>
    </div>
    <div style="background:var(--bg3);border:1px solid var(--gold-bd);border-radius:10px;padding:1rem;text-align:center;">
      <div style="font-family:'Cormorant Garamond',serif;font-size:1.8rem;color:var(--green);font-weight:700;">${roi}%</div>
      <div style="font-size:0.72rem;color:var(--muted);margin-top:2px;text-transform:uppercase;">ROI on Plan Investment</div>
    </div>
  </div>
  <div style="margin-top:0.75rem;font-size:0.8rem;color:var(--muted);text-align:center;">₹${plan}/mo investment → ${bookings.toFixed(1)} bookings → ₹${revenue.toLocaleString('en-IN')} revenue</div>`;
}

function copyText(id, content) {
  navigator.clipboard.writeText(content).then(() => {
    const btn = document.getElementById(id);
    btn.textContent='✅ Copied!'; btn.classList.add('copied');
    setTimeout(()=>{btn.textContent='📋 Copy';btn.classList.remove('copied');},2000);
  });
}
function showErr(id, msg) { const e=document.getElementById(id); e.textContent=msg; e.classList.add('show'); }
function esc(s){return s.replace(/\\/g,'\\\\').replace(/`/g,'\\`').replace(/\$/g,'\\$');}
function escHtml(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
</script>
</body>
</html>
