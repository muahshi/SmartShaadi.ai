{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.smartshaadi.online"
        }
      ],
      "destination": "https://smartshaadi.online/$1",
      "permanent": true
    },
    {
      "source": "/vendors/apply",
      "destination": "/vendors/apply.html",
      "permanent": true
    },
    {
      "source": "/blog-delhi-wedding-cost-2026",
      "destination": "/blog-delhi-wedding-cost-2026.html",
      "permanent": true
    },
    {
      "source": "/blog-bangalore-wedding-cost-2026",
      "destination": "/blog-bangalore-wedding-cost-2026.html",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/wedding-budget-calculator-india-2026",
      "destination": "/wedding-budget-calculator-india-2026.html",
      "permanent": true
    },
    {
      "source": "/ai-wedding-theme-generator",
      "destination": "/ai-wedding-theme-generator.html",
      "permanent": true
    },
    {
      "source": "/chatbot",
      "destination": "/chatbot.html",
      "permanent": true
    },
    {
      "source": "/wedding-vendor-negotiation-bot",
      "destination": "/wedding-vendor-negotiation-bot.html",
      "permanent": true
    },
    {
      "source": "/nri-wedding-blog",
      "destination": "/nri-wedding-blog.html",
      "permanent": true
    },
    {
      "source": "/apply",
      "destination": "/vendors/apply.html",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/blogs.html",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "/ai-tools.html",
      "permanent": true
    },
    {
      "source": "/budget",
      "destination": "/wedding-budget-calculator-india-2026.html",
      "permanent": true
    },
    {
      "source": "/kundali",
      "destination": "/ai-kundali-matching.html",
      "permanent": true
    },
    {
      "source": "/invitation",
      "destination": "/ai-invitation-writer.html",
      "permanent": true
    },
    {
      "source": "/planner",
      "destination": "/app.html",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' *"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/((?!.*\\.html$).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' *"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}