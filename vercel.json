{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "smartshaadi.online" }],
      "destination": "https://www.smartshaadi.online/$1",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/blogs", "destination": "/blogs.html", "permanent": true },
    { "source": "/contact", "destination": "/contact.html", "permanent": true },
    { "source": "/about", "destination": "/about.html", "permanent": true },
    { "source": "/chatbot", "destination": "/chatbot.html", "permanent": true },
    { "source": "/dashboard", "destination": "/dashboard.html", "permanent": true },
    { "source": "/planner", "destination": "/app.html", "permanent": true },
    { "source": "/budget", "destination": "/wedding-budget-calculator-india-2026.html", "permanent": true },
    { "source": "/kundali", "destination": "/ai-kundali-matching.html", "permanent": true },
    { "source": "/invitation", "destination": "/ai-invitation-writer.html", "permanent": true },
    { "source": "/apply", "destination": "/vendors/apply.html", "permanent": true },
    { "source": "/blog", "destination": "/blogs.html", "permanent": true },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html", "permanent": true },
    { "source": "/terms", "destination": "/terms.html", "permanent": true },
    { "source": "/vendors", "destination": "/vendors/index.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
