{
  "functions": {
    "api/groq-agent.js": { "maxDuration": 30 },
    "api/razorpay-order.js": { "maxDuration": 10 },
    "api/razorpay-verify.js": { "maxDuration": 10 },
    "api/whatsapp-bot.js": { "maxDuration": 30 }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
